# Application
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://fleet_user:fleet_password@localhost:5432/fleet_db
DB_USER=fleet_user
DB_PASSWORD=fleet_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleet_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Telematics
TELEMATICS_MODE=mock

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
